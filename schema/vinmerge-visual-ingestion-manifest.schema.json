{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vinmerge.africa/schema/vinmerge-visual-ingestion-manifest.schema.json",
  "title": "VINMERGE Visual Ingestion Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "assets"],
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_record_id", "asset_id", "asset_type", "role", "source", "status"],
        "properties": {
          "canonical_record_id": { "type": "string", "minLength": 1 },
          "asset_id": { "type": "string", "minLength": 1 },
          "asset_type": { "type": "string", "enum": ["exploded_diagram", "technical_illustration", "actual_product", "installation_context", "packaging", "vehicle_context", "reference_image"] },
          "role": { "type": "string", "enum": ["identification", "navigation", "purchase_confidence", "installation_guidance", "packaging_verification", "vehicle_context", "reference"] },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["oem_public", "supplier", "dealer", "user_upload", "licensed_catalogue", "ai_generated", "other"] },
              "name": { "type": ["string", "null"] },
              "source_reference": { "type": ["string", "null"] },
              "license": { "type": ["string", "null"] },
              "license_status": { "type": "string", "enum": ["unknown", "pending", "permitted", "restricted", "rejected"] }
            }
          },
          "status": { "type": "string", "enum": ["pending_review", "verified", "rejected", "archived"] },
          "file_path": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"], "format": "uri-reference" },
          "thumbnail_url": { "type": ["string", "null"], "format": "uri-reference" },
          "original_image_ref": { "type": ["string", "null"] },
          "storage_key": { "type": ["string", "null"] },
          "mime_type": { "type": ["string", "null"] },
          "file_size_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "dimensions": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          },
          "image_hash": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
          "visual_tags": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
            "then": {
              "properties": {
                "source": {
                  "properties": {
                    "license_status": { "const": "permitted" }
                  },
                  "required": ["license_status"]
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "file_path": { "type": "string", "minLength": 1 }
                  },
                  "required": ["file_path"]
                },
                {
                  "properties": {
                    "url": { "type": "string", "minLength": 1, "format": "uri-reference" }
                  },
                  "required": ["url"]
                }
              ]
            }
          },
          {
            "if": { "properties": { "status": { "const": "pending_review" } }, "required": ["status"] },
            "then": {}
          }
        ]
      }
    }
  }
}
