{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vinmerge.africa/schema/vinmerge-visual-index.schema.json",
  "title": "VINMERGE Visual Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["visual_index_version", "description", "records"],
  "properties": {
    "visual_index_version": { "type": "string", "const": "1.0" },
    "description": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_record_id", "visual"],
        "properties": {
          "canonical_record_id": { "type": "string", "minLength": 1 },
          "visual": { "$ref": "https://vinmerge.africa/schema/vinmerge-visual-intelligence.schema.json" }
        }
      }
    }
  }
}
